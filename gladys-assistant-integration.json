          "default": true,
          "label": {
            "en": "Show open or closed and the countdown",
            "fr": "Afficher l'état et le compte à rebours",
            "de": "Status und Countdown anzeigen",
            "es": "Mostrar el estado y la cuenta atrás"
          }
