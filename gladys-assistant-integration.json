    {
      "key": "upcoming_closures",
      "label": {
        "en": "Bridge closures",
        "fr": "Fermetures du pont",
        "de": "Brückensperrungen",
        "es": "Cierres del puente"
      },
      "description": {
        "en": "Open or closed now, countdown to the next closure and the closures to come.",
        "fr": "Ouvert ou fermé, compte à rebours de la prochaine fermeture et les fermetures à venir.",
        "de": "Offen oder gesperrt, Countdown bis zur nächsten Sperrung und die kommenden Sperrungen.",
        "es": "Abierto o cerrado, cuenta atrás del próximo cierre y los cierres por venir."
      },
      "icon": "calendar",
