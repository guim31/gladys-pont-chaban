{
  "manifest_version": 1,
  "type": "device",
  "name": "Pont Chaban-Delmas",
  "description": {
    "en": "Closures of the Chaban-Delmas lift bridge in Bordeaux: closed now, next ones, scene alerts.",
    "fr": "Fermetures du pont levant Chaban-Delmas à Bordeaux : état, prochaines levées, alertes de scène.",
    "de": "Sperrungen der Hubbrücke Chaban-Delmas in Bordeaux: jetzt gesperrt, nächste, Szenenalarme.",
    "es": "Cierres del puente levadizo Chaban-Delmas en Burdeos: estado, próximos cierres, alertas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-pont-chaban:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-pont-chaban/main/cover.png",
  "categories": ["services"],
  "countries": ["FR"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Closures come from the Bordeaux Métropole open data (Licence Ouverte), free and without an account. The integration reads them every hour; times are Bordeaux times, shown in the Gladys time zone.",
        "fr": "Les fermetures viennent de l'open data de Bordeaux Métropole (Licence Ouverte), gratuit et sans compte. L'intégration les lit toutes les heures ; heures de Bordeaux, affichées dans le fuseau de Gladys.",
        "de": "Die Sperrungen stammen aus den Open Data von Bordeaux Métropole (Licence Ouverte), kostenlos und ohne Konto. Die Integration liest sie stündlich; Uhrzeiten aus Bordeaux, in der Zeitzone von Gladys angezeigt.",
        "es": "Los cierres proceden de los datos abiertos de Bordeaux Métropole (Licence Ouverte), gratuitos y sin cuenta. La integración los lee cada hora; horas de Burdeos, mostradas en la zona horaria de Gladys."
      },
      "links": [
        {
          "url": "https://opendata.bordeaux-metropole.fr/explore/dataset/previsions_pont_chaban/",
          "label": {
            "en": "Dataset",
            "fr": "Jeu de données",
            "de": "Datensatz",
            "es": "Conjunto de datos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the device and feature names, of the text values and of the scene sentences. Names are set when the device is created: to rename them, delete and re-add the device.",
        "fr": "Langue des noms d'appareil et de fonctionnalités, des valeurs textuelles et des phrases de scène. Les noms sont fixés à la création : pour les renommer, supprimez puis rajoutez l'appareil.",
        "de": "Sprache der Geräte- und Funktionsnamen, der Textwerte und der Szenensätze. Die Namen werden beim Anlegen festgelegt: Zum Umbenennen lösche das Gerät und füge es erneut hinzu.",
        "es": "Idioma de los nombres del dispositivo y de las funciones, de los valores de texto y de las frases de escena. Los nombres se fijan al crearlos: para cambiarlos, elimine el dispositivo y vuelva a añadirlo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check",
        "fr": "Vérifier",
        "de": "Prüfen",
        "es": "Comprobar"
      },
      "description": {
        "en": "Reads the Bordeaux Métropole schedule again now and shows the next closure.",
        "fr": "Relit maintenant le planning de Bordeaux Métropole et affiche la prochaine fermeture.",
        "de": "Liest den Plan von Bordeaux Métropole jetzt neu und zeigt die nächste Sperrung.",
        "es": "Vuelve a leer ahora el calendario de Bordeaux Métropole y muestra el próximo cierre."
      },
      "timeout_seconds": 60
    }
